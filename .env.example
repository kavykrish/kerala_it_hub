# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it's already in .gitignore).

GROQ_API_KEY=your_groq_api_key_here

# Optional: require this exact value in the X-API-Key header on /ask.
# Set it once you deploy publicly so random people who get your APK
# can't run up your Groq bill or scrape through your backend for free.
# Leave blank for local development.
API_KEY=
